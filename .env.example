# Version utilisée pour le tag de l'image Docker.
VERSION=0.1.0

# Port publié sur l'hôte.
PORT=3000

# Interface d'écoute du port publié. 127.0.0.1 évite toute exposition réseau.
HOST_BIND=127.0.0.1

# Réseau Docker externe à rejoindre. Il doit exister avant docker compose up.
EXTERNAL_NETWORK=app-net
